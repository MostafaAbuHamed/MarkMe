# Port the preview API listens on (Cloud Run sets PORT in production).
PORT=8787

# Local Supabase API URL (printed by `pnpm exec supabase status --workdir packages/database`).
SUPABASE_URL=http://127.0.0.1:54321

# Comma-separated browser origins allowed for CORS (default: chrome-extension://dapmmcamlgmaopfaicfjifakodajigha).
# CORS_ORIGINS=chrome-extension://dapmmcamlgmaopfaicfjifakodajigha

# Max preview requests per IP per minute (default: 60).
# RATE_LIMIT_IP_PER_MIN=60

# Max preview requests per authenticated user per minute (default: 20).
# RATE_LIMIT_USER_PER_MIN=20

# Max preview requests per authenticated user per day (default: 300).
# RATE_LIMIT_USER_PER_DAY=300

# Max force-refresh preview requests per user per hour (default: 10).
# RATE_LIMIT_FORCE_PER_HOUR=10

# Optional Meta oEmbed access token for higher Instagram rate limits (unset in v1).
# META_OEMBED_TOKEN=
