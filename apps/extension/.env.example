# Local Supabase API URL (printed by `pnpm exec supabase status --workdir packages/database`).
WXT_SUPABASE_URL=http://127.0.0.1:54321
# Public anon key from `pnpm exec supabase status`. pnpm dev fills this in; never put a service-role key here.
WXT_SUPABASE_ANON_KEY=replace-with-your-local-anon-key
# Local preview API.
WXT_PREVIEW_API_URL=http://127.0.0.1:8787
